# Optional overrides for deploy/compose/compose.yaml. Copy to deploy/compose/.env
# (git-ignored); compose reads it automatically.
#
# zitadel-bootstrap runs as this non-root uid:gid so it can write the host copy of
# deploy/compose/.env.generated. Set them to `id -u` / `id -g` when your uid is not 1000
# (for example a CI runner). The stack works without the host copy; compose-check needs it.
HOST_UID=1000
HOST_GID=1000

# ai-py model provider. Unset = the fake gateway (canned output, no API key, results forced to needs_review).
# Run extraction through any OpenAI-compatible endpoint instead (the key stays in your shell or this
# git-ignored .env, never in the repo). OpenRouter free models:
#   AI_PROVIDER=openai_compat
#   AI_OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   AI_OPENAI_API_KEY=
# Google Gemini (OpenAI-compatible endpoint):
#   AI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_OPENAI_MODEL_FAST=gemini-2.5-flash
#   AI_OPENAI_MODEL_SMART=gemini-2.5-flash
# Optional model overrides: AI_OPENAI_MODEL_FAST (intake) and AI_OPENAI_MODEL_SMART (extraction, critic).
# Free-tier reliability (defaults shown; empty = default): calls are paced to AI_OPENAI_MAX_RPM per minute
# (0 = off), transient errors (429 per-minute, 503, timeouts) are retried up to AI_OPENAI_MAX_ATTEMPTS = 5 times
# waiting at most AI_OPENAI_MAX_RETRY_WAIT_S = 120 s for a Retry-After, image/PDF calls may take
# AI_OPENAI_TIMEOUT_S = 240 s. A DAILY quota (Gemini 2.5 Flash free tier: 20 requests per day per model) is
# never retried: the call fails as quota_exhausted until the provider's reset. Pick a model with headroom.
#   AI_OPENAI_MAX_RPM=10
