# Optional overrides for deploy/compose/compose.yaml. Copy to deploy/compose/.env
# (git-ignored); compose reads it automatically.
#
# zitadel-bootstrap runs as this non-root uid:gid so it can write the host copy of
# deploy/compose/.env.generated. Set them to `id -u` / `id -g` when your uid is not 1000
# (for example a CI runner). The stack works without the host copy; compose-check needs it.
HOST_UID=1000
HOST_GID=1000
